<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Header Row with App Title, Date, and Refresh Button / Progress Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NUBTK Timer"
            android:textColor="@color/widget_title"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/widget_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/widget_date"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <FrameLayout
            android:id="@+id/widget_refresh_container"
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageButton
                android:id="@+id/btn_widget_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_widget_refresh"
                android:contentDescription="Refresh Widget"
                android:scaleType="centerInside" />

            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Center Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp">

        <!-- Status Badge -->
        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_status"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:text="WORKING DAY"
            android:textColor="@color/widget_pill_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Working Day Countdown Section (Visible on working days, completely hidden on holidays/leaves) -->
        <LinearLayout
            android:id="@+id/widget_timer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:id="@+id/widget_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00:00"
                android:textColor="@color/widget_timer_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_sub_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Target: 8h 00m"
                android:textColor="@color/widget_sub_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Holiday / Leave / Special Day Section (Replaces time-count area on holidays and leaves) -->
        <LinearLayout
            android:id="@+id/widget_special_day_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_special_day_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official Holiday"
                android:textColor="@color/widget_special_day_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2" />

            <TextView
                android:id="@+id/widget_special_day_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Office Closed"
                android:textColor="@color/widget_special_day_desc"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="2"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Off Day Message Banner (shown on holidays/leaves/weekends) -->
    <TextView
        android:id="@+id/widget_offday_text"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="Today is your off day"
        android:textColor="@color/widget_offday_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/widget_pill_status"
        android:visibility="gone" />

    <!-- Action Buttons Row (shown on working days) -->
    <LinearLayout
        android:id="@+id/widget_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="visible">

        <Button
            android:id="@+id/btn_widget_punch_in"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_punch_in"
            android:text="Punch In"
            android:textColor="@color/widget_button_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_widget_punch_out"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_punch_out"
            android:text="Punch Out"
            android:textColor="@color/widget_button_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
